<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Program.cs is the sole entry point; App.xaml must NOT generate its own Main -->
    <ApplicationDefinition>Program.cs</ApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Windows.Forms, System.Drawing and System.ServiceProcess are separate packages in .NET 8 -->
    <PackageReference Include="System.Windows.Forms"               Version="4.0.4" />
    <PackageReference Include="System.Drawing.Common"              Version="8.0.4" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="4.9.0" />
    <PackageReference Include="System.Management"                  Version="8.0.0" />
    <PackageReference Include="Microsoft.PowerShell.SDK"           Version="7.4.3" />
  </ItemGroup>

</Project>
