<UserControl x:Class="TreasuryFixTool.Views.LoginUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA">

    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0"
            Width="420" MinHeight="540" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Opacity="0.1"/>
        </Border.Effect>

        <Grid Margin="35,25,35,25">

            <StackPanel x:Name="PanelLogin" Visibility="Visible">
                <TextBlock Text="TreasuryFixTool" FontSize="28" FontWeight="Bold" Foreground="#1A4A75" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="National Treasury IT Support Unit" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Department / Unit:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <ComboBox x:Name="ComboDepartment" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="IT Support Unit" IsSelected="True"/>
                    <ComboBoxItem Content="Internal Audit &amp; Control"/>
                    <ComboBoxItem Content="Accounts &amp; Treasury Management"/>
                    <ComboBoxItem Content="System Administration"/>
                </ComboBox>

                <TextBlock Text="Username:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtUsername" Height="35" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Password:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <PasswordBox x:Name="TxtPassword" Height="35" Padding="5,5,40,5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                    <TextBox x:Name="TxtPasswordUnmasked" Height="35" Padding="5,5,40,5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" Visibility="Collapsed"/>
                    <Button x:Name="BtnTogglePassword" Content="👁" Width="30" Height="25" HorizontalAlignment="Right" Margin="0,0,5,0" Background="Transparent" BorderBrush="Transparent" Click="BtnTogglePassword_Click" Cursor="Hand"/>
                </Grid>

                <Grid Margin="0,5,0,25">
                    <CheckBox x:Name="ChkRememberMe" Content="Remember my login ID" Foreground="#475569" VerticalAlignment="Center"/>
                    <TextBlock Text="Forgot Password?" Foreground="#1A4A75" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>

                <Button x:Name="BtnLogin" Content="Sign In" Height="42" Background="#1A4A75" Foreground="White" FontWeight="Bold" FontSize="15" BorderBrush="Transparent" Click="BtnLogin_Click" Cursor="Hand"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="New user? " Foreground="#64748B"/>
                    <TextBlock Text="Create an account" Foreground="#1A4A75" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="LinkRegister_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock Text="Staff Registration" Foreground="#16A34A" FontWeight="SemiBold" Cursor="Hand" MouseLeftButtonDown="LinkStaffRegister_Click"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                <TextBlock Text="Create Account" FontSize="26" FontWeight="Bold" Foreground="#1A4A75" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Register a new system support profile" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Full Name:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtRegFullName" Height="35" Margin="0,0,0,12" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Official Email Address:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtRegEmail" Height="35" Margin="0,0,0,12" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Choose Username:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtRegUsername" Height="35" Margin="0,0,0,12" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Password:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtRegPassword" Height="35" Margin="0,0,0,12" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                <TextBlock Text="Confirm Password:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,15"/>
                <PasswordBox x:Name="TxtRegConfirmPassword" Height="35" Margin="0,0,0,20" Padding="5" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>

                <Button x:Name="BtnSubmitRegister" Content="Register Account" Height="42" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="15" BorderBrush="Transparent" Click="BtnSubmitRegister_Click" Cursor="Hand"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Already registered? " Foreground="#64748B"/>
                    <TextBlock Text="Sign In" Foreground="#1A4A75" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="LinkSignIn_Click"/>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
