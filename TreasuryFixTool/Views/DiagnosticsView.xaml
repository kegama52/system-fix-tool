<UserControl x:Class="TreasuryFixTool.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F4F8">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#1F497D" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="System Diagnostics" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Event Log Records and System Health Summary" FontSize="12" Foreground="#FADBD8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
            <ItemsControl x:Name="EventRecords">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                BorderBrush="#D1D9E6" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                           FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Source}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1E293B" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#475569"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border DockPanel.Dock="Bottom" Background="#E2E8F0" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshBtn" Content="Refresh" Padding="12,4" Click="Refresh_Click"
                        Background="#2E75B6" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button x:Name="ExportBtn" Content="Export Logs" Padding="12,4" Click="Export_Click"
                        Background="#379237" Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>