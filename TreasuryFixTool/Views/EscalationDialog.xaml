<UserControl x:Class="TreasuryFixTool.Views.EscalationDialog"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Background="#F0F4F8">

    <DockPanel Margin="16">
        <!-- Progress ring at top -->
        <Border DockPanel.Dock="Top" Background="#C0392B" CornerRadius="6" Padding="16,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🚨" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Escalation Required"
                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="EscalationStatus"
                               Text="TreasuryFixTool could not resolve all issues automatically."
                               FontSize="12" Foreground="#FADBD8" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Export Logs" Padding="10,4" Margin="0,0,6,0"
                            Click="ExportLogs_Click"
                            Background="#EBF0F8" Foreground="#1F497D"
                            BorderBrush="#CBD2DA" BorderThickness="1"
                            Cursor="Hand"/>
                    <Button Content="Generate Ticket" Padding="14,6"
                            Click="Generate_Click"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Department Selector -->
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="6"
                Padding="14,8" Margin="0,0,0,12"
                BorderBrush="#D1D9E6" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Your Department" FontWeight="Bold" FontSize="13"
                           Foreground="#1E293B" Margin="0,0,0,6"/>
                <ComboBox x:Name="DeptCombo" Height="30" FontSize="13"
                          SelectionChanged="DeptCombo_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Error Details -->
        <Border Background="White" CornerRadius="6" Padding="14"
                BorderBrush="#D1D9E6" BorderThickness="1"
                DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Detected Issues" FontWeight="Bold" FontSize="13"
                           Foreground="#1E293B" Margin="0,0,0,8"/>
                <TextBlock x:Name="DetectedIssuesText" FontSize="12" Foreground="#475569"
                           TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
        </Border>

        <!-- Escalation log history -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="EscalationsHistory">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Margin="0,0,0,6"
                                Background="White" CornerRadius="6"
                                BorderBrush="#D1D9E6" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                               FontSize="11" Foreground="#64748B" FontStyle="Italic"/>
                                    <TextBlock Text="{Binding CheckName}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#1E293B"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#C0392B"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button Grid.Column="2" Content="Open JSON" Padding="8,3"
                                        Click="ViewJson_Click"
                                        Background="#EBF0F8" Foreground="#1F497D"
                                        BorderBrush="#CBD2DA" BorderThickness="1"
                                        Cursor="Hand" Tag="{Binding FilePath}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Toast / Success banner -->
        <Border x:Name="SuccessBanner" DockPanel.Dock="Bottom"
                Background="#27AE60" CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SuccessText" FontSize="13" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </DockPanel>
</UserControl>
