<UserControl x:Class="TreasuryFixTool.Views.HealthDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F0F4F8">

  <Border Background="{Binding CurrentBg}" CornerRadius="0">
    <DockPanel>

      <!-- ══════════════════════════════════════════════════════
           TOOLBAR – theme toggle, scan button, export
      ══════════════════════════════════════════════════════ -->
      <Border DockPanel.Dock="Top"
              Background="{Binding CurrentHeaderBrush}"
              CornerRadius="0"
              Padding="14,10"
              Height="54">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="🏥"
                       FontSize="20"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBlock Text="TreasuryFixTool — System Health Dashboard"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{Binding CurrentHeaderTextBrush}"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <ToggleButton x:Name="ThemeToggle"
                          Content="🌙"
                          Width="36" Height="26"
                          Padding="4,0"
                          Margin="0,0,10,0"
                          ToolTip="Toggle light / dark theme"
                          Checked="ThemeToggle_Checked"
                          Unchecked="ThemeToggle_Checked"/>
            <Button x:Name="RunScanBtn"
                    Content="▶ Run Full Scan"
                    Padding="20,6"
                    Click="RunFullScan_Click"
                    Background="#379237"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    FontSize="12"
                    ToolTip="Run all system diagnostic checks  (F5)"
                    Margin="0,0,8,0"/>
            <Button x:Name="ExportReportBtn"
                    Content="📄 Export Report"
                    Padding="18,6"
                    Click="ExportScanReport_Click"
                    Background="#2980B9"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontWeight="SemiBold"
                    FontSize="12"
                    ToolTip="Save scan results as CSV, TXT, or JSON  (Ctrl+E)"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══════════════════════════════════════════════════════
           SCROLLABLE CONTENT AREA
      ══════════════════════════════════════════════════════ -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Padding="12"
                    Background="{Binding CurrentPanelBg}">

        <StackPanel>

          <!-- ── ROW 1: METRIC CARDS (4×2 wrap panel) ── -->
          <TextBlock Text="System Overview"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#475569"
                     Margin="0,0,0,8"/>

          <WrapPanel x:Name="MetricCardsHost"
                     Margin="0,0,0,16"
                     ItemHeight="108" ItemWidth="220"/>

          <!-- ── ROW 2: ESCALATION PANEL ── -->
          <Border x:Name="EscalationPanel"
                  Background="White"
                  BorderBrush="#C0392B"
                  BorderThickness="1.5"
                  CornerRadius="8"
                  Padding="14"
                  Margin="0,0,0,14"
                  Visibility="Collapsed">
            <DockPanel>
              <!-- Escalation Panel Header -->
              <Border DockPanel.Dock="Top"
                      Background="#FADBD8"
                      CornerRadius="4"
                      Padding="8,6"
                      Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock Text="🚨"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Active Escalations"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#C0392B"
                               VerticalAlignment="Center"/>
                    <Border x:Name="EscalationBadge"
                            Background="#C0392B"
                            CornerRadius="6"
                            Padding="4,1 6,1"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                      <TextBlock x:Name="EscalationBadgeText"
                                 Text="0"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="White"/>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="EscalationRefreshLabel"
                             Grid.Column="1"
                             Text="Auto-refreshes every 30 s"
                             FontSize="10"
                             Foreground="#95A5A6"
                             VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <!-- Escalation List -->
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            MaxHeight="220"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,8">
                <ItemsControl x:Name="EscalationList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FDF2F8"
                              BorderBrush="#F5B7B1"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="10,8"
                              Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,3">
                              <TextBlock Text="{Binding Timestamp,
                                            StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                         FontSize="10"
                                         Foreground="#888888"
                                         FontStyle="Italic"/>
                              <Border x:Name="SeverityBadge"
                                      CornerRadius="3"
                                      Padding="4,1 6,1"
                                      Margin="6,0,0,0"
                                      HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Severity}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                              </Border>
                              <TextBlock Text="{Binding Team}"
                                         FontSize="10"
                                         Foreground="#555555"
                                         Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}"
                                       FontSize="12"
                                       Foreground="#1E293B"
                                       TextWrapping="Wrap"
                                       LineHeight="16"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Orientation="Horizontal"
                                      VerticalAlignment="Center">
                            <Button Content="✓ Acknowledge"
                                    Padding="8,3"
                                    Margin="0,0,4,0"
                                    Click="AcknowledgeEscalation_Click"
                                    Tag="{Binding .}"
                                    Background="#27AE60"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>
                            <Button Content="✓ Resolve"
                                    Padding="8,3"
                                    Click="ResolveEscalation_Click"
                                    Tag="{Binding .}"
                                    Background="#2980B9"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock x:Name="EscalationFooterText"
                         Text="No active escalations."
                         FontSize="11"
                         Foreground="#888888"
                         FontStyle="Italic"
                         TextAlignment="Center"
                         HorizontalAlignment="Stretch"/>
            </DockPanel>
          </Border>

          <!-- ── ROW 3: SCAN CONTROLS + PROGRESS ── -->
          <Border Background="White"
                  BorderBrush="#D1D9E6"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="18,14"
                  Margin="0,0,0,14">
            <DockPanel>
              <Border DockPanel.Dock="Top"
                      Background="#EBF5FB"
                      CornerRadius="4"
                      Padding="8,6"
                      Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ScanStatusLabel"
                             Text="Ready — click 'Run Full Scan' to begin"
                             FontSize="12"
                             Foreground="#1F497D"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="ScanElapsedLabel"
                             Grid.Column="1"
                             Text=""
                             FontSize="10"
                             Foreground="#888888"
                             FontStyle="Italic"
                             VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ProgressBar x:Name="ScanProgressBar"
                           Height="16"
                           Minimum="0"
                           Maximum="100"
                           Value="0"
                           Background="#E8EDF2"
                           Foreground="#2E75B6"
                           BorderThickness="0"
                           DockPanel.Dock="Top"
                           Margin="0,0,0,10"/>
              <TextBlock x:Name="StepsLabel"
                         Text="Checks: 0 / 0  |  0%"
                         FontSize="10"
                         Foreground="#888888"
                         DockPanel.Dock="Top"
                         Margin="0,0,0,6"/>
            </DockPanel>
          </Border>

          <!-- ── ROW 4: SCAN RESULTS LOG (COLLAPSIBLE) ── -->
          <Border Background="White"
                  BorderBrush="#D1D9E6"
                  BorderThickness="1"
                  CornerRadius="8">
            <DockPanel>
              <!-- Log header / expand toggle -->
              <Border DockPanel.Dock="Top"
                      Background="#1F497D"
                      CornerRadius="8 8 0 0"
                      Padding="10,7"
                      Cursor="Hand"
                      MouseLeftButtonUp="LogHeader_Click">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock x:Name="LogToggleIcon"
                               Text="▶"
                               FontSize="11"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="📋 Scan Results Log"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogCompleteLabel"
                               Text=""
                               FontSize="10"
                               Foreground="#AED6F1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock x:Name="LogResultCount"
                               Text="0 entries"
                               FontSize="10"
                               Foreground="#AED6F1"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button x:Name="ClearLogBtn"
                            Content="🗑 Clear"
                            Padding="8,3"
                            Click="ClearLog_Click"
                            Background="#C0392B"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="10"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Filter toolbar -->
              <Border DockPanel.Dock="Top"
                      Background="#F8FAFC"
                      BorderBrush="#DEE2E6"
                      BorderThickness="0,0,0,1"
                      Padding="8,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Filter:"
                             FontSize="11"
                             Foreground="#555555"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0"/>
                  <ComboBox x:Name="LogFilterCombo"
                            Grid.Column="1"
                            Width="96"
                            Height="22"
                            FontSize="11"
                            SelectionChanged="LogFilterCombo_SelectionChanged"
                            SelectedIndex="0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="PASS"/>
                    <ComboBoxItem Content="FAIL"/>
                    <ComboBoxItem Content="WARN"/>
                    <ComboBoxItem Content="ERROR"/>
                  </ComboBox>
                  <TextBox x:Name="LogSearchBox"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           Height="22"
                           Padding="4,0"
                           FontSize="11"
                           ToolTip="Search log entries…"
                           TextChanged="LogSearchBox_TextChanged"/>
                  <Button Grid.Column="3"
                          Content="🔍"
                          Width="26" Height="22"
                          Padding="2"
                          Margin="4,0,0,0"
                          Cursor="Hand"
                          ToolTip="Search (Ctrl+F)"
                          BorderBrush="#D1D9E6"
                          BorderThickness="1"
                          Background="White"
                          Click="LogSearchBtn_Click"/>
                  <Button Grid.Column="4"
                          Content="📧 Send Email Update"
                          Padding="10,3"
                          Margin="6,0,0,0"
                          Click="LogSendEmailUpdate_Click"
                          Background="#2980B9"
                          Foreground="White"
                          BorderThickness="0"
                          Cursor="Hand"
                          FontSize="10"
                          ToolTip="Open your default email client with ticket fields pre-filled"/>
                </Grid>
              </Border>

              <!-- Log entries -->
              <ScrollViewer x:Name="LogScrollViewer"
                            VerticalScrollBarVisibility="Auto"
                            MaxHeight="300">
                <ItemsControl x:Name="LogEntriesHost">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding EntryBg}"
                              Padding="8,5"
                              Margin="0,1,0,0"
                              BorderBrush="{Binding EntryBorder}"
                              BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0"
                                     Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                     FontSize="10"
                                     Foreground="#888888"
                                     FontFamily="Consolas"/>
                          <Border Grid.Column="1"
                                  CornerRadius="3"
                                  Padding="2,0 6,0"
                                  Background="{Binding StatusBadgeBg}"
                                  HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusLetter}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Description}"
                                     FontSize="11"
                                     Foreground="#1E293B"
                                     TextWrapping="Wrap"
                                     Margin="8,0,0,0"/>
                          <TextBlock Grid.Column="3"
                                     Text="{Binding Duration}"
                                     FontSize="10"
                                     Foreground="#888888"
                                     FontFamily="Consolas"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ══════════════════════════════════════════════════════
           STATUS BAR
      ══════════════════════════════════════════════════════ -->
      <Border DockPanel.Dock="Bottom"
              Background="#1F497D"
              Padding="8,4"
              BorderThickness="1,1,0,0"
              BorderBrush="#2980B9">
        <TextBlock x:Name="BottomStatusBar"
                   Text="TreasuryFixTool  |  Ready  |  National Treasury IT Support Unit"
                   FontSize="10"
                   Foreground="#AED6F1"/>
      </Border>

    </DockPanel>
  </Border>
</UserControl>
