<Window x:Class="TreasuryFixTool.MainWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:views="clr-namespace:TreasuryFixTool.Views"
          Title="TreasuryFixTool — National Treasury IT Support"
          Height="720" Width="1100"
          MinHeight="500" MinWidth="700"
          WindowStartupLocation="CenterScreen"
          Background="#EBF0F8">

    <DockPanel LastChildFill="True">
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#1F497D" Padding="10,6" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TreasuryFixTool — National Treasury IT Support Unit"
                           FontSize="14" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Run Scan"     Padding="14,4" Margin="0,0,6,0" Click="Scan_Click"
                            Background="#379237" Foreground="White" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold"/>
                    <Button Content="Request Assistance" Padding="14,4" Click="Escalate_Click"
                            Background="#C0392B" Foreground="White" BorderThickness="0"
                            Cursor="Hand" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control -->
        <TabControl x:Name="MainTabControl" Padding="12,8" AutomationProperties.Name="Main Navigation Tabs">
            <TabItem Header="Health Dashboard" Padding="16,6" AutomationProperties.Name="Health Dashboard Tab">
                <views:HealthDashboard/>
            </TabItem>
            <TabItem Header="Diagnostics" Padding="16,6" AutomationProperties.Name="Diagnostics Tab">
                <views:DiagnosticsView/>
            </TabItem>
            <TabItem Header="Escalation" Padding="16,6" AutomationProperties.Name="Escalation Tab">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Escalation Banner -->
                    <Border Grid.Row="0" Background="#D32F2F" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="M12 2L1 21h22M12 6l-7.5 13h15M12 10v4M12 16h.01"
                                  Stroke="White" StrokeThickness="2" Width="32" Height="32"
                                  VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Escalation Required" FontWeight="Bold" FontSize="16"
                                           Foreground="White" Margin="0,0,0,5"/>
                                <TextBlock Text="TreasuryFixTool could not resolve all issues automatically. Choose your preferred support method."
                                           Foreground="White" Opacity="0.9" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Export Logs" Click="ExportLogs_Click"
                                        Background="White" Foreground="#D32F2F"
                                        Padding="15,8" Margin="0,0,10,0"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                                <Button Content="Generate Ticket" Click="GenerateTicket_Click"
                                        Background="#FF5722" Foreground="White"
                                        Padding="15,8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick Actions Panel -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                            BorderBrush="#E0E0E0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Quick Actions" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                            <WrapPanel>
                                <Button Content="📞 Call IT Assistant" Click="CallAssistant_Click"
                                        Background="#1976D2" Foreground="White"
                                        Padding="20,12" Margin="0,0,10,10"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                        Width="180"/>

                                <Button Content="💬 Live Chat Support" Click="LiveChat_Click"
                                        Background="#388E3C" Foreground="White"
                                        Padding="20,12" Margin="0,0,10,10"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                        Width="180"/>

                                <Button Content="🖨️ Print Issues Report" Click="PrintIssuesReport_Click"
                                        Background="#7B1FA2" Foreground="White"
                                        Padding="20,12" Margin="0,0,10,10"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                        Width="180"/>

                                <Button Content="📧 Email Support" Click="EmailSupport_Click"
                                        Background="#F57C00" Foreground="White"
                                        Padding="20,12" Margin="0,0,10,10"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                        Width="180"/>

                                <Button Content="🖥️ Request Remote Session" Click="RemoteSession_Click"
                                        Background="#0097A7" Foreground="White"
                                        Padding="20,12" Margin="0,0,10,10"
                                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                                        Width="180"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Main Content -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="350"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel - Ticket Form -->
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Create Support Ticket" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

                                    <!-- Department -->
                                    <TextBlock Text="Your Department *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="DepartmentComboBox" Margin="0,0,0,15" Padding="10,8">
                                        <ComboBoxItem Content="IT Services (ICTSU)"/>
                                        <ComboBoxItem Content="Procurement"/>
                                        <ComboBoxItem Content="Finance"/>
                                        <ComboBoxItem Content="Human Resources"/>
                                        <ComboBoxItem Content="Administration"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>

                                    <!-- Priority -->
                                    <TextBlock Text="Priority Level *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <RadioButton x:Name="PriorityLow" Content="Low" GroupName="Priority"
                                                   Margin="0,0,20,0" Padding="5"/>
                                        <RadioButton x:Name="PriorityMedium" Content="Medium" GroupName="Priority"
                                                   IsChecked="True" Margin="0,0,20,0" Padding="5"/>
                                        <RadioButton x:Name="PriorityHigh" Content="High" GroupName="Priority"
                                                   Margin="0,0,20,0" Padding="5"/>
                                        <RadioButton x:Name="PriorityCritical" Content="Critical" GroupName="Priority"
                                                   Padding="5"/>
                                    </StackPanel>

                                    <!-- Issue Category -->
                                    <TextBlock Text="Issue Category *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,15" Padding="10,8">
                                        <ComboBoxItem Content="Network Connectivity"/>
                                        <ComboBoxItem Content="Software Installation"/>
                                        <ComboBoxItem Content="Hardware Failure"/>
                                        <ComboBoxItem Content="Printer Issues"/>
                                        <ComboBoxItem Content="Email Problems"/>
                                        <ComboBoxItem Content="System Performance"/>
                                        <ComboBoxItem Content="Security/Access"/>
                                        <ComboBoxItem Content="Other"/>
                                    </ComboBox>

                                    <!-- Description -->
                                    <TextBlock Text="Detailed Description *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="DescriptionTextBox" Height="120" Margin="0,0,0,15"
                                           TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top"
                                           Padding="10" BorderBrush="#BDBDBD" BorderThickness="1"/>

                                    <!-- Steps Already Taken -->
                                    <TextBlock Text="Steps Already Taken" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBox x:Name="StepsTextBox" Height="80" Margin="0,0,0,15"
                                           TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Top"
                                           Padding="10" BorderBrush="#BDBDBD" BorderThickness="1"/>

                                    <!-- Contact Info -->
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Contact Name *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ContactNameTextBox" Padding="10,8"
                                                   BorderBrush="#BDBDBD" BorderThickness="1"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"/>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Extension/Phone *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBox x:Name="ContactPhoneTextBox" Padding="10,8"
                                                   BorderBrush="#BDBDBD" BorderThickness="1"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Attachments -->
                                    <TextBlock Text="Attachments" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1"
                                            CornerRadius="4" Padding="15" Margin="0,0,0,15">
                                        <StackPanel>
                                            <CheckBox x:Name="AttachLogsCheckBox" Content="Include System Logs"
                                                    IsChecked="True" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="AttachScreenshotsCheckBox" Content="Include Screenshots"
                                                    Margin="0,0,0,8"/>
                                            <CheckBox x:Name="AttachConfigCheckBox" Content="Include System Configuration"
                                                    Margin="0,0,0,8"/>
                                            <Button Content="Add Additional Files" Click="AddFiles_Click"
                                                  Background="White" BorderBrush="#1976D2" BorderThickness="1"
                                                  Padding="10,6" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Submit Button -->
                                    <Button Content="Submit Ticket" Click="SubmitTicket_Click"
                                          Background="#4CAF50" Foreground="White"
                                          Padding="20,12" HorizontalAlignment="Right"
                                          BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Grid Splitter -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                     Background="#E0E0E0" ResizeDirection="Columns"/>

                        <!-- Right Panel - Detected Issues & System Info -->
                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Detected Issues -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Detected Issues" FontWeight="Bold" FontSize="14"
                                             Margin="0,0,0,10"/>
                                    <Border x:Name="IssuesPanel" Background="#FFEBEE" BorderBrush="#FFCDD2"
                                           BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15"
                                           MinHeight="100">
                                        <StackPanel x:Name="IssuesList">
                                            <TextBlock Text="No issues detected" Foreground="#9E9E9E"
                                                     FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- System Information -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                                    <TextBlock Text="System Information" FontWeight="Bold" FontSize="14"
                                             Margin="0,0,0,10"/>
                                    <Border Background="#F5F5F5" CornerRadius="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Machine Name:" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="SysMachineName" Text="Loading..."
                                                     Margin="0,0,0,8" FontSize="11"/>

                                            <TextBlock Text="OS Version:" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="SysOSVersion" Text="Loading..."
                                                     Margin="0,0,0,8" FontSize="11"/>

                                            <TextBlock Text="IP Address:" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="SysIPAddress" Text="Loading..."
                                                     Margin="0,0,0,8" FontSize="11"/>

                                            <TextBlock Text="Last Scan:" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="SysLastScan" Text="Never"
                                                     FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Print Button -->
                                <Button Grid.Row="2" Content="🖨️ Print Issues Report" Click="PrintIssuesReport_Click"
                                      Background="#7B1FA2" Foreground="White"
                                      Padding="15,10" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Self-Test" Padding="16,6" AutomationProperties.Name="Self-Test Tab">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Run Self-Tests" Click="RunSelfTests_Click" Padding="10,5" Margin="0,0,8,0"/>
                        <Button Content="Reset Winsock" Click="RunFix_Click" Padding="10,5"/>
                    </StackPanel>

                    <TextBox x:Name="TestOutputBox"
                             Height="200"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Troubleshooting Guide" Padding="16,6" AutomationProperties.Name="Troubleshooting Guide Tab">
                <views:TroubleshootingGuideView/>
            </TabItem>
            <TabItem Header="Update" Padding="16,6" AutomationProperties.Name="Update Tab">
                <views:UpdateView/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#DDE3EA" Padding="8,3" BorderThickness="0,1,0,0" BorderBrush="#CBD2DA">
            <TextBlock x:Name="AppStatusBar"
                       Text="TreasuryFixTool v1.0  |  Offline Mode  |  National Treasury"
                       FontSize="10" Foreground="#475569"/>
        </Border>
    </DockPanel>
</Window>
